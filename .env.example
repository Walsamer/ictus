# ictus — example environment. Copy to .env for local runs.
# Never commit real values. See docs/ for the secret-handling boundary.

# Where the local Dagster instance stores run history (durable execution state).
# Must be an absolute path: the submission lock and run/event stores are derived
# from it, and the bridge and dagster-daemon are separate processes.
DAGSTER_HOME=/var/lib/ictus/dagster_home

# Copy examples/dagster/dagster.yaml and examples/dagster/workspace.yaml into
# $DAGSTER_HOME.  Run `uv run --frozen dagster-daemon run` independently before
# submitting work.  Its queue is deliberately limited to two concurrent runs.

# Name of the code location registered in the daemon's workspace.yaml.  Durable
# submission requires it; see docs/DURABLE_SUBMISSION.md.
ICTUS_DAGSTER_CODE_LOCATION=ictus
# Optional repository name inside that code location (default: __repository__).
#ICTUS_DAGSTER_REPOSITORY=__repository__

# Optional override for the Rust -> Dagster bridge command used by `ictus`.
# Default: `uv run --frozen python -m ictus_dagster.bridge`
#ICTUS_DAGSTER_BRIDGE_CMD=uv run --frozen python -m ictus_dagster.bridge

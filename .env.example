# agentic-control — example environment. Copy to .env for local runs.
# Never commit real values. See docs/ for the secret-handling boundary.

# Where the local Dagster instance stores run history (durable execution state).
DAGSTER_HOME=./.dagster_home

# Optional override for the Rust -> Dagster bridge command used by `ac-bridge`.
# Default: `uv run --frozen python -m agentic_dagster.bridge`
#AGENTIC_DAGSTER_BRIDGE_CMD=uv run --frozen python -m agentic_dagster.bridge

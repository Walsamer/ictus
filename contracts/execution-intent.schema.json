{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictus.dev/contracts/execution-intent.schema.json",
  "title": "ExecutionIntent",
  "description": "The only object allowed to cross into an execution backend. It carries a validated, bounded action and never carries durable workflow state (retries, step state, run persistence belong to the backend).",
  "type": "object",
  "required": ["schema_version", "intent_id", "capability", "target", "requested_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "intent_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "target": { "$ref": "#/$defs/subject" },
    "arguments": { "type": "object" },
    "policy_context": { "type": "object" },
    "selected_route": {
      "$ref": "#/$defs/selected_route",
      "description": "The only backend/provider/runtime/model route authorized by Ictus. Runtime adapters must reject stale fact revisions and must not substitute another route."
    },
    "requested_by": { "$ref": "#/$defs/requested_by" }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "requested_by": {
      "type": "object",
      "required": ["provider", "decision_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "decision_id": { "type": "string", "minLength": 1 }
      }
    },
    "route_identity": {
      "type": "object",
      "required": ["backend", "provider", "runtime", "model"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "route_fact_ref": {
      "type": "object",
      "required": ["fact_id", "revision"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "selected_route": {
      "type": "object",
      "required": ["route", "descriptor", "health", "quota", "disablement"],
      "properties": {
        "route": { "$ref": "#/$defs/route_identity" },
        "descriptor": { "$ref": "#/$defs/route_fact_ref" },
        "health": { "$ref": "#/$defs/route_fact_ref" },
        "quota": { "$ref": "#/$defs/route_fact_ref" },
        "disablement": { "$ref": "#/$defs/route_fact_ref" }
      },
      "additionalProperties": false
    }
  }
}
